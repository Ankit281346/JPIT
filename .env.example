# AI Provider Configuration
# Supported options: gemini, openai, claude
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn Automation Configuration
LINKEDIN_SESSION_PATH=data/linkedin_session.json
LINKEDIN_HEADLESS=false

# Google Cloud OAuth 2.0 (Gmail API) Configuration
# Using Option A: credentials.json in the project root
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json

# Database Connection
DATABASE_URL=sqlite:///./data/api_c2c.db

# Safe Mode / Live Email Sending Toggle
# DRY_RUN=false enables REAL Gmail delivery
DRY_RUN=false

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO